# Get a free API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that contact form submissions should be delivered to.
# Falls back to the email on the Profile row in the database if unset.
CONTACT_TO_EMAIL=you@example.com

# Your production URL, used to resolve absolute Open Graph / Twitter image URLs.
# Set this to your real Vercel/custom domain after deploying.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Neon Postgres connection string. Put this in `.env`, not `.env.local` —
# Next.js reads both, but the Prisma CLI only reads `.env`.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Single shared password for the /admin dashboard, checked by src/proxy.ts.
# Unset means the admin is locked, not open.
ADMIN_PASSWORD=choose-something-long-and-random

# The AI assistant (the chat button on every page) needs one of these keys; its button stays
# hidden until one is set. If both are set, Claude is used.
#
# Free: a Gemini API key from https://aistudio.google.com/apikey (no card needed). On the free
# tier, Google may use the questions and answers to improve its products.
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: the Gemini model — a Gemini 3 model. Defaults to gemini-3.8-flash.
# GEMINI_MODEL=gemini-3.8-flash
#
# Paid: an Anthropic API key from https://console.anthropic.com/settings/keys (set a monthly
# spend limit there too). Left commented out here because it takes priority over Gemini.
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: the Claude model. Defaults to claude-opus-5-5.
# CLAUDE_MODEL=claude-opus-5-5

# Vercel Blob token, used for image uploads on the Projects/Case Studies admin forms.
# Get this from your Vercel project's Storage tab → your Blob store → Quickstart/.env.local tab.
# Do NOT also set BLOB_STORE_ID here — if it's present, the SDK prefers OIDC auth, which
# Vercel disallows for local ("development") use and throws BlobOidcEnvironmentNotAllowedError.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
